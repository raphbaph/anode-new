  "rules": {
    "current_rule": "Fintech allocated yield = 90% \u00d7 its qualifying balance / total eUSD supply \u00d7 total distributable revenue. Stakers receive remainder (100% of direct-balance-attributable yield + 10% of fintech-balance-attributable yield).",
    "current_rule_source": "https://forum.reserve.org/t/ip-revenue-share-programme-fintech-revenue-share-adjustment/1463",
    "original_program_source": "https://forum.reserve.org/t/rfc-eusd-rev-share-with-fintech-apps/801",
    "latest_snapshot_source": "https://forum.reserve.org/t/rfc-eusd-revenue-share-programme-update-08-10-2026/1664",
    "operational_threshold": "Biweekly snapshots; advance to IP only when any recipient calculated allocation differs >=3% relative from current on-chain allocation, per Oct 8 RFC. Snapshot proposed shares therefore need not equal actual paid shares.",
    "fixed_rule_model": "Flat staker share applies to all distributable yield. For a simple comparison, remainder allocated to UC/Sentz proportional to qualifying balances, but this is an illustrative design choice rather than an established proposal.",
    "fees": "Workbook allocation formulas sum to 100% and Oct sheet has no separate fee/champion allocation; original historical sheets have zero proposed champion share. Source does not establish whether all raw collateral yield reaches distributable revenue. Use effective distributable yield input or expose fee haircut; do not imply raw basket APY equals net distributable yield."
  },
  "limitations": [
    "History is governance-reported snapshots, not independently verified blockchain balances.",
    "Direct balance is residual total supply less qualifying fintech wallets; label outside fintech, not individual end-user balances.",
